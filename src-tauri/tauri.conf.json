{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quikclip",
  "version": "0.1.0",
  "identifier": "studio.quikclip.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:tools && npm run dev",
    "beforeBuildCommand": "npm run prepare:tools && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Quikclip Studio", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 640, "resizable": true, "backgroundColor": "#121315" }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'self'",
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/media/*/source.mp4", "$APPLOCALDATA/media/*/frame-*.jpg", "$APPLOCALDATA/media/*/wave.png"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/quikclip-yt-dlp", "binaries/quikclip-qjs", "binaries/quikclip-ffmpeg", "binaries/quikclip-ffprobe"],
    "resources": { "../public/sample/alpine.mp4": "sample/alpine.mp4", "../public/fonts/": "fonts/", "tool-notices/": "notices/", "../LICENSE": "notices/GPL-3.0.txt", "../THIRD_PARTY_TOOLS.md": "notices/THIRD_PARTY_TOOLS.md" }
  }
}
